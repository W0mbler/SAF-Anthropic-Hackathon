# Local development only. Compose binds published ports to loopback.
APP_ENV=development
POSTGRES_DB=safcommand
POSTGRES_USER=saf
POSTGRES_PASSWORD=saf-local-development
SESSION_SECRET=
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SOLVER_TIME_LIMIT_SECONDS=20
SOLVER_RELATIVE_GAP=0.02
# Optional, server-side only. No AI key/model is required to use the app.
OPENAI_API_KEY=
OPENAI_MODEL=
